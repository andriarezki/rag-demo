{
  "name": "rag-demo",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Small retrieval-augmented generation (RAG) demo: ask questions about a folder of documents and get answers with numbered sources. TypeScript, SQLite vector store, Gemini or Claude, with an offline fallback.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ingest": "tsx src/cli.ts ingest",
    "ask": "tsx src/cli.ts ask",
    "eval": "tsx src/cli.ts eval"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^4.21.0",
    "pdfjs-dist": "^6.4.299",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT"
}
