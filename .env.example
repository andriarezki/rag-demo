# All optional. With no keys the app still runs: it uses the offline hash embedder
# and returns the most relevant passages instead of a written answer.

# Embeddings + answers with Gemini (Google AI Studio key)
GEMINI_API_KEY=
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_MODEL=gemini-3.8-flash

# Answers with Claude (used for the answer step if set; embeddings stay on Gemini or the hash embedder)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# Retrieval tuning
# TOP_K=4
# MIN_SCORE=          # leave empty to use the default for the active embedder

# Server
# PORT=3000
# DB_FILE=data/rag.db
# DOCS_DIR=docs/sample
