# Pagewise settings. Save this file after editing, then restart start.bat.
# Lines that start with # are ignored.

# Name and description shown on the web page.
APP_NAME=Pagewise
APP_SUBTITLE=Ask about your documents. Answers cite the file name and page number.

# Example questions shown as buttons, separated by | . Leave empty for no example buttons.
APP_EXAMPLES=

# Folder with your documents (PDF, TXT, MD). Subfolders are read too. Example: D:\Pilot-Documents
DOCS_DIR=docs\sample

# Port of the web page. From another PC open http://IP-ADDRESS-OF-THIS-PC:3000
PORT=3000

# Web login. YOU MUST CHANGE THE PASSWORD. The app refuses to start while it is still the placeholder.
APP_USER=researcher
APP_PASSWORD=CHANGE-THIS-PASSWORD

# Log of every question (time, IP, question, result, sources) for evaluating the pilot. Leave empty to turn logging off.
LOG_QUESTIONS=data\questions.log

# Where the search index is stored
DB_FILE=data\rag.db

# --- Optional: AI service on the internet (Option B). LEAVE EMPTY for offline mode. ---
# If you fill this in, the relevant passages are sent to that service for every question.
# Only for non-confidential documents and only after approval from your manager and the head-office IT team.
GEMINI_API_KEY=
