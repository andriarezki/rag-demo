# Pengaturan asisten dokumen. Simpan file ini setelah diubah, lalu jalankan ulang start.bat.
# Baris yang diawali tanda # diabaikan.

# Nama dan keterangan yang tampil di halaman web.
APP_NAME=Pagewise
APP_SUBTITLE=Tanya isi dokumen. Jawaban disertai nama berkas dan nomor halaman.

# Contoh pertanyaan yang tampil sebagai tombol, dipisah tanda | . Kosongkan jika tidak ingin ada tombol contoh.
APP_EXAMPLES=

# Folder berisi dokumen (PDF, TXT, MD), subfolder ikut dibaca. Isi dengan folder dokumen pilot, misalnya D:\Dokumen-Pilot
DOCS_DIR=docs\sample

# Port halaman web. Dari PC lain buka http://ALAMAT-IP-PC-INI:3000
PORT=3000

# Login halaman web. WAJIB diganti. Aplikasi menolak jalan jika password masih contoh.
APP_USER=peneliti
APP_PASSWORD=GANTI-DENGAN-PASSWORD-ANDA

# Catatan semua pertanyaan (waktu, IP, pertanyaan, hasil, sumber) untuk evaluasi pilot. Kosongkan baris ini jika tidak ingin mencatat.
LOG_QUESTIONS=data\questions.log

# Lokasi indeks pencarian
DB_FILE=data\rag.db

# --- Opsional: layanan AI di internet (Opsi B). KOSONGKAN untuk mode offline. ---
# Jika diisi, potongan dokumen yang relevan dikirim ke layanan tersebut setiap ada pertanyaan.
# Hanya untuk dokumen tidak rahasia dan setelah ada izin atasan dan IT pusat.
GEMINI_API_KEY=
